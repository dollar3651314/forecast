# 测试环境的变量清单（沿用复制源的部署方案，forecast 的部署方案在 S14 写）。只有变量名，没有值。
# 在服务器上：cp env.example .env && chmod 600 .env，然后由 Amos 填值（不发到对话里，不进仓库）。
# 密码类的值用部署方案第 6 节给的命令生成（只用字母和数字，不带换行）。

# ---- 域名（D2）和证书 ----
APP_DOMAIN=
ADMIN_DOMAIN=
# 官网（例如 test-www.<域名>）；证书要包含这个域名
WWW_DOMAIN=
# Let's Encrypt 证书快到期时的提醒邮箱
CERT_EMAIL=

# ---- 第一步就要填 ----
MYSQL_ROOT_PASSWORD=
FC_DB_PASSWORD=
FC_REDIS_PASSWORD=
# 第一个超级管理员（首次登录必须改密码；建好以后可以删掉这两行）
FC_ADMIN_INIT_USERNAME=
FC_ADMIN_INIT_PASSWORD=

# ---- 浏览器推送（测试环境单独一对，不能和生产共用）----
FC_PUSH_VAPID_PUBLIC_KEY=
FC_PUSH_VAPID_PRIVATE_KEY=
# mailto: 开头的联系邮箱
FC_PUSH_VAPID_SUBJECT=

# ---- 邮件（D3，服务商定了以后填；空着时邮件只写进日志）----
FC_MAIL_HOST=
FC_MAIL_PORT=587
# STARTTLS 或 SSL
FC_MAIL_SECURITY=STARTTLS
FC_MAIL_USERNAME=
FC_MAIL_PASSWORD=
FC_MAIL_FROM=

# ---- 资金告警收件人（提现紧急告警、归集异常转出等发给员工的邮件，notification/service/StaffAlerts；逗号分隔）----
FC_RISK_ALERT_EMAILS=

# ---- 监控告警收件人（扫块停滞、链节点连不上、邮件连续失败；逗号分隔）----
# 没有默认值，必须由 Amos 填（架构方案第 1.4 节 ⑤）；空着时告警只写日志
FC_ALERT_EMAILS=

# ---- 雪花 ID 节点号（v2 第 11.4 节，0–1023）：单实例空着（默认 1）；以后多实例时每个实例填不同的值 ----
FC_ID_NODE=

# ---- 结算派彩每批的持仓数（forecast S5，开发记录/S5-结算.md）：空着 = 500（先算好再分批派彩，每批一个事务、可以续跑；
# 架构方案第 4.3 节方案 B，AQ-3 已定）；填 0 = 计算和派彩在同一个事务里一次完成（会锁住全部下注客户的账户几秒）----
FC_SETTLE_BATCH_SIZE=

# ---- 加密自动裁决的第三源 Coinbase（forecast S6，开发记录/S6-加密自动化.md；AQ-13 默认关闭）：空着 = false；
# true = 币安（主）或 OKX（备）一方拿不到时用 Coinbase 的 BTC-USD K 线补位。币安、OKX 是公开行情接口，不要 key ----
FC_SOURCE_COINBASE_ENABLED=

# ---- 体育数据源的 key（forecast S8，开发记录/S8-体育自动化.md；AQ-17）：Amos 注册后填，不经过 AI、不进仓库。
# 空着的来源"未开通"：不调用，健康检查 alerts 里显示 DOWN，赛程同步跳过、用到它的体育市场转人工。
# 足球主源 football-data.org（免费档，注册后邮件里的 API token）；NBA 主源 balldontlie（免费档 key）；足球和 NBA 的备源 TheSportsDB
# （测试环境可以用它公开的免费 key，上线时买 $9/月 的档拿独立 key，AQ-17）----
FC_SRC_FOOTBALL_DATA_TOKEN=
FC_SRC_BALLDONTLIE_KEY=
FC_SRC_THESPORTSDB_KEY=

# ---- 区块链（D4 第二步，全部用测试网；没配置的链不扫块）----
# TRON 的账户级 xpub（只有公钥）。ERC20、BEP20 没有 xpub：充值地址只用下面"资金归集"四个合约地址算出的 CREATE2 地址
FC_WALLET_TRON_XPUB=
FC_WALLET_ETH_RPC_URL=
FC_WALLET_BSC_RPC_URL=
FC_WALLET_TRON_RPC_URL=
FC_WALLET_ERC20_USDT_CONTRACT=
FC_WALLET_BSC_USDT_CONTRACT=
FC_WALLET_TRC20_USDT_CONTRACT=
FC_WALLET_ETH_HOT_KEY=
FC_WALLET_TRON_HOT_KEY=
FC_WALLET_ETH_HOT_ADDRESS=
FC_WALLET_TRON_HOT_ADDRESS=

# ---- ERC20、BEP20 充值地址和资金归集（部署方案/v1-归集合约部署.md；合约见 contracts/README.md）----
# 前四个是 Amos 部署合约后得到的公开地址（Deploy.s.sol 最后会打印这几行）：四个都填对了，ERC20、BEP20 才开通充值（地址 = CREATE2 合约地址）；
# 没填或填错 = 这两条链"暂未开通"（不退回 xpub），健康检查 alerts 的 deposit.evm 报 DOWN（status 不变）。以太坊、BSC 共用同一组。
# 填了以后不要改（改了新客户的地址会变）
FC_SWEEP_EVM_FACTORY=
FC_SWEEP_EVM_IMPLEMENTATION=
FC_SWEEP_EVM_PARENT=
FC_SWEEP_EVM_BATCHER=
# 发起账户（新的以太坊体系账户，只付手续费，不是热钱包）：地址是公开的；私钥只由 Amos 填，启动时和地址核对，
# 对不上或没填时只是不能执行归集，不影响启动和健康检查
FC_SWEEP_EVM_OPERATOR_ADDRESS=
FC_SWEEP_EVM_OPERATOR_KEY=
