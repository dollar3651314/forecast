# 测试环境的变量清单（部署方案 `部署方案/v1-测试环境与切换.md`、`部署方案/v1-测试环境第一次部署清单.md`）。只有变量名，没有值。
# 在服务器上不用手工复制：server-setup.sh 从本文件建 /opt/forecast/.env（权限 600），init-env.sh 生成密码、密钥对和第一个超管，
# 其余由 Amos 用 `sudo nano /opt/forecast/.env` 自己填（不发到对话里、不截图、不进仓库）。值只用字母、数字和 - _ . @ : / ,，不加引号、不带换行。
#
# 每个变量前面标了：
#   【必填·自动】  init-env.sh 生成或写入，Amos 不用填；缺了 first-start.sh、docker compose 会拒绝启动
#   【验收前填】  不填也能启动，但测试环境验收要用（例如没有邮件就收不到注册验证码）
#   【可选】      不填也能安全启动：对应功能"未开通 / 未配置"，健康检查（后台域名）的 alerts 里显示 DOWN，不影响 status 和自动更新
# 没写在这里、但 docker-compose.yml 里固定了的（FC_ENV_LABEL=test、FC_COOKIE_SECURE、FC_DB_URL、FC_REDIS_HOST、内存和线程上限等）不用填。

# ---- 域名（SQ-4）和证书 ----
# 【必填·自动】init-env.sh 的参数：fc-test.quickcome.online、fc-test-admin.quickcome.online、证书提醒邮箱、fc-test-www.quickcome.online
APP_DOMAIN=
ADMIN_DOMAIN=
# 官网；证书要包含这个域名
WWW_DOMAIN=
# 【可选】对外预热域名（S18，P1；例如 www.quickcome.online）：根路径显示等候页，不显示测试环境标识。不用手工填：
# 运行 sudo fc add-domain www.quickcome.online（检查 DNS → 扩展证书 → 写进这里 → 重新加载 → 自己验证）。空着 = 没有预热域名
PRELAUNCH_DOMAIN=
# 【必填·自动】Let's Encrypt 证书快到期时的提醒邮箱（只有 first-start.sh 申请证书时用）
CERT_EMAIL=

# ---- 数据库、Redis 和第一个超管 ----
# 【必填·自动】init-env.sh 生成随机值
MYSQL_ROOT_PASSWORD=
FC_DB_PASSWORD=
FC_REDIS_PASSWORD=
# 【必填·自动】第一个超级管理员（用户名 admin、随机初始密码；首次登录必须改密码）。第一次登录改完密码以后可以删掉这两行
FC_ADMIN_INIT_USERNAME=
FC_ADMIN_INIT_PASSWORD=

# ---- 浏览器推送（测试环境单独一对，不能和生产共用）----
# 【必填·自动】init-env.sh 生成（公钥、私钥一对，联系方式 = mailto:证书提醒邮箱）。三个都空 = 不发推送（站内信、邮件照常）；只填一部分 = 推送不可用
FC_PUSH_VAPID_PUBLIC_KEY=
FC_PUSH_VAPID_PRIVATE_KEY=
# mailto: 开头的联系邮箱
FC_PUSH_VAPID_SUBJECT=

# ---- 邮件（Resend，Amos 待办 T3；架构方案第 11.8 节）----
# 【验收前填】空着时邮件只写进日志、不发出去：注册、找回密码收不到验证码。除了 FC_MAIL_PASSWORD，其他几项的值是公开的（见第一次部署清单第 6 步）
FC_MAIL_HOST=
FC_MAIL_PORT=587
# STARTTLS 或 SSL
FC_MAIL_SECURITY=STARTTLS
FC_MAIL_USERNAME=
# Resend 的 API key（Resend 的 SMTP 密码就是 API key）：只由 Amos 自己粘贴，不发给 AI
FC_MAIL_PASSWORD=
# 完整发信地址，必须在 Resend 里已验证的子域名下（例如 noreply@fc-email.quickcome.online）
FC_MAIL_FROM=

# ---- 资金告警收件人（提现紧急告警、归集异常转出、结算异常、裁决提醒等发给员工的邮件，notification/service/StaffAlerts；逗号分隔）----
# 【可选】空着时只写日志
FC_RISK_ALERT_EMAILS=

# ---- 监控告警收件人（扫块停滞、链节点连不上、邮件连续失败；逗号分隔）----
# 【验收前填】没有默认值，必须由 Amos 填（架构方案第 1.4 节 ⑤）；空着时告警只写日志
FC_ALERT_EMAILS=

# ---- 雪花 ID 节点号（v2 第 11.4 节，0–1023）----
# 【可选】单实例空着（默认 1）；以后多实例时每个实例填不同的值
FC_ID_NODE=

# ---- 结算派彩每批的持仓数（forecast S5，开发记录/S5-结算.md）----
# 【可选】空着 = 500（先算好再分批派彩，每批一个事务、可以续跑；架构方案第 4.3 节方案 B，AQ-3 已定）；
# 填 0 = 计算和派彩在同一个事务里一次完成（会锁住全部下注客户的账户几秒）
FC_SETTLE_BATCH_SIZE=

# ---- 不登录也能看（forecast S13，MF-4；需求要求打开）----
# 【可选】空着 = true（市场列表、详情、今日场次、开奖记录、周报、说明页不登录也能看，搜索引擎可以收录）；填 false = 要登录、robots.txt 禁止收录
FC_PUBLIC_BROWSE_ENABLED=

# ---- 加密自动裁决的第三源 Coinbase（forecast S6，开发记录/S6-加密自动化.md；AQ-13 默认关闭）----
# 【可选】空着 = false；true = 币安（主）或 OKX（备）一方拿不到时用 Coinbase 的 BTC-USD K 线补位。币安、OKX 是公开行情接口，不要 key
FC_SOURCE_COINBASE_ENABLED=

# ---- 体育数据源的 key（forecast S8，开发记录/S8-体育自动化.md；AQ-17；Amos 待办 T14）----
# 【可选】Amos 注册后填，不经过 AI、不进仓库。空着的来源"未开通"：不调用，健康检查 alerts 里显示 DOWN，赛程同步跳过、用到它的体育市场转人工。
# 足球主源 football-data.org（免费档，注册后邮件里的 API token）；NBA 主源 balldontlie（免费档 key）；足球和 NBA 的备源 TheSportsDB
# （测试环境可以先不填，上线时买 $9/月 的档拿独立 key，AQ-17）
FC_SRC_FOOTBALL_DATA_TOKEN=
FC_SRC_BALLDONTLIE_KEY=
FC_SRC_THESPORTSDB_KEY=

# ---- 事件和文章自动化（forecast S15，开发记录/S15-自动化程序.md；需求文档/v1.3-事件和文章自动化.md）----
# 【可选】内容程序跑在应用进程里（自己的线程池和表，没有上架市场、动资金的权限）。空着 = true；填 false = 关掉整个内容程序（其他功能照常）
FC_CONTENT_ENABLED=
# 【可选】Google Gemini 的 API key（EQ-5：免费档，和体育比分解析共用；Amos 待办 T4）：Amos 在 Google AI Studio 申请后填，不经过 AI、不进仓库。
# 空着 = 后台显示"Gemini 未配置"：AI 起草（文章、帖子、SEO 说明、回复）不可用，经济日历市场草稿、数据卡、SEO 页面的数据照常
FC_GEMINI_API_KEY=
# 【可选】模型：空着 = gemini-2.5-flash-lite
FC_GEMINI_MODEL=
# 【可选】Polymarket 公开接口（工具里的大 V 对照图引用同类题的概率；数据页 /data 的 Polymarket 一块也跟这个开关）：
# 使用条款待核实（SQ-39，打开前再问 Amos），空着 = false 不调用
FC_SOURCE_POLYMARKET_ENABLED=

# ---- 官方 Telegram 机器人（forecast S16，MF-7；Amos 待办 T16）----
# 【可选】Amos 在 Telegram 里找 @BotFather，/newbot 建机器人后得到的 token，只填在这里（不要发给任何人、不要发给 AI）。
# 空着时机器人不启动，健康检查 alerts 里 telegram.bot 显示 DOWN（不影响网站）。频道编号、开关、模板审定在后台"内容中心 → Telegram 机器人"页
FC_TELEGRAM_BOT_TOKEN=

# ---- 区块链（全部用测试网；没配置的链不扫块，客户端显示"充值暂未开通"）----
# 【可选】TRON 的账户级 xpub（只有公钥）。ERC20、BEP20 没有 xpub：充值地址只用下面"资金归集"四个合约地址算出的 CREATE2 地址
FC_WALLET_TRON_XPUB=
# 【可选】节点地址（测试网）
FC_WALLET_ETH_RPC_URL=
FC_WALLET_BSC_RPC_URL=
FC_WALLET_TRON_RPC_URL=
# 【可选】USDT 合约地址（测试网）
FC_WALLET_ERC20_USDT_CONTRACT=
FC_WALLET_BSC_USDT_CONTRACT=
FC_WALLET_TRC20_USDT_CONTRACT=
# 【可选】链 ID：空着 = Sepolia 11155111、BSC 测试网 97（compose 里的默认值）
FC_WALLET_ERC20_CHAIN_ID=
FC_WALLET_BSC_CHAIN_ID=
# 【可选】热钱包：私钥只由 Amos 填；地址是公开的
FC_WALLET_ETH_HOT_KEY=
FC_WALLET_TRON_HOT_KEY=
FC_WALLET_ETH_HOT_ADDRESS=
FC_WALLET_TRON_HOT_ADDRESS=

# ---- ERC20、BEP20 充值地址和资金归集（部署方案/v1-归集合约部署.md；合约见 contracts/README.md；Amos 待办 T5～T10）----
# 【可选】前四个是 Amos 部署合约后得到的公开地址（Deploy.s.sol 最后会打印这几行）：四个都填对了，ERC20、BEP20 才开通充值（地址 = CREATE2 合约地址）；
# 没填或填错 = 这两条链"暂未开通"（不退回 xpub），健康检查 alerts 的 deposit.evm 报 DOWN（status 不变）。以太坊、BSC 共用同一组。
# 填了以后不要改（改了新客户的地址会变）
FC_SWEEP_EVM_FACTORY=
FC_SWEEP_EVM_IMPLEMENTATION=
FC_SWEEP_EVM_PARENT=
FC_SWEEP_EVM_BATCHER=
# 【可选】发起账户（新的以太坊体系账户，只付手续费，不是热钱包）：地址是公开的；私钥只由 Amos 填，启动时和地址核对，
# 对不上或没填时只是不能执行归集，不影响启动和健康检查
FC_SWEEP_EVM_OPERATOR_ADDRESS=
FC_SWEEP_EVM_OPERATOR_KEY=
