pragma solidity 0.8.20;

import {Script} from "forge-std/Script.sol";
import {DepositSalt} from "../src/DepositSalt.sol";

/// 生成 CREATE2 地址的测试向量（方案第 4.14 节"地址算法三方一致"）：
///   forge script script/GenVectors.s.sol
/// 写到 backend/src/test/resources/wallet/create2-vectors.json。后端 Java（Create2Test）和 Foundry（Vectors.t.sol，真的用 BitGo 工厂部署）
/// 都读这一份文件核对。工厂和实现合约地址是固定的假地址（测试里用 deployCodeTo 部署到这两个地址）。
/// 不连任何节点、不需要私钥。
contract GenVectors is Script {
    string constant OUT = "../backend/src/test/resources/wallet/create2-vectors.json";
    address constant FACTORY = 0xfAC70000000000000000000000000000000000f1;
    address constant IMPLEMENTATION = 0x1111000000000000000000000000000000000FF1;
    uint256 constant PER_PAIR = 250;

    function run() external {
        address[4] memory parents = [address(0x5aFE00000000000000000000000000000000A001), vm.addr(0xA11CE), vm.addr(0xB0B), vm.addr(0xC0FFEE)];
        address[4] memory fees = [address(0xba7c000000000000000000000000000000000001), vm.addr(0xD00D), vm.addr(0xFEE), vm.addr(0xBEEF)];
        uint256 n = parents.length * PER_PAIR;
        address[] memory ps = new address[](n);
        address[] memory fs = new address[](n);
        uint256[] memory users = new uint256[](n);
        bytes32[] memory salts = new bytes32[](n);
        address[] memory addrs = new address[](n);
        bytes32 initHash = keccak256(abi.encodePacked(hex"3d602d80600a3d3981f3363d3d373d3d3d363d73", IMPLEMENTATION, hex"5af43d82803e903d91602b57fd5bf3"));
        for (uint256 k; k < n; ++k) {
            uint256 pair = k / PER_PAIR;
            uint256 j = k % PER_PAIR;
            // 前 100 个是 1..100，最后一个是 int 上限，其余伪随机（≤ 2^31 - 1：AddressService 要求用户 ID 不超过 int）
            uint256 user = j < 100 ? j + 1 : j == PER_PAIR - 1 ? 2_147_483_647 : uint256(keccak256(abi.encode(pair, j))) % 2_147_483_647 + 1;
            bytes32 salt = DepositSalt.forUser(user);
            bytes32 finalSalt = keccak256(abi.encodePacked(parents[pair], fees[pair], salt));
            ps[k] = parents[pair];
            fs[k] = fees[pair];
            users[k] = user;
            salts[k] = salt;
            addrs[k] = address(uint160(uint256(keccak256(abi.encodePacked(bytes1(0xff), FACTORY, finalSalt, initHash)))));
        }
        string memory o = "vectors";
        vm.serializeString(o, "description", "CREATE2 deposit addresses: salt = keccak256('forecast-deposit' || uint256 userId); address = CREATE2(factory, keccak256(parent || feeAddress || salt), keccak256(EIP-1167 proxy(implementation))). Generated by contracts/script/GenVectors.s.sol; checked by contracts/test/Vectors.t.sol (real BitGo factory) and backend Create2Test.");
        vm.serializeAddress(o, "factory", FACTORY);
        vm.serializeAddress(o, "implementation", IMPLEMENTATION);
        vm.serializeAddress(o, "parents", ps);
        vm.serializeAddress(o, "feeAddresses", fs);
        vm.serializeUint(o, "userIds", users);
        vm.serializeBytes32(o, "salts", salts);
        string memory json = vm.serializeAddress(o, "addresses", addrs);
        vm.writeJson(json, OUT);
    }
}
